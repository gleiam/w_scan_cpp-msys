 void cCondWait::SleepMs(int TimeoutMs)
 {
+#ifdef __MSYS__
+  // Unter Cygwin/MSYS erzeugt jede pthread_mutex/cond-Init Kernel-Handles.
+  // SleepMs wird in Warteschleifen sehr oft aufgerufen (pro Aufruf je 1x
+  // mutex+cond init/destroy); Win32-Sleep vermeidet das vollstaendig.
+  // Linux-Verhalten unveraendert (Fallthrough zum cCondWait-Pfad).
+  Sleep((DWORD)max(TimeoutMs, 3)); // Win32 Sleep (ms), windows.h bereits eingebunden
+#else
   cCondWait w;
   w.Wait(max(TimeoutMs, 3)); // making sure the time is >2ms to avoid a possible busy wait
+#endif
 }
 
